<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  A launchd agent that runs the Moebius server. Replace /Users/you with your home directory (launchd does not expand ~),
  then:

    mkdir -p ~/Library/LaunchAgents ~/Library/Logs "$HOME/Library/Application Support/moebius"
    cp dev.moebius.server.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.moebius.server.plist

  It expects `moebius` in /usr/local/bin and the configuration in ~/Library/Application Support/moebius/moebius.toml.
  Stop it with `launchctl bootout gui/$(id -u)/dev.moebius.server`.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.moebius.server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/moebius</string>
        <string>serve</string>
        <string>--config</string>
        <string>/Users/you/Library/Application Support/moebius/moebius.toml</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/you/Library/Application Support/moebius</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/you/Library/Logs/moebius.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/you/Library/Logs/moebius.log</string>
</dict>
</plist>
