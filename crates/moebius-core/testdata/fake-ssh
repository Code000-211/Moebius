#!/usr/bin/env python3
# A stand-in for `ssh` in tests: the "remote machine" is this one, so the command it is given runs here, in a shell, with
# the standard input and output of the ssh (for `git push`, a `tar` pipe, or a harness speaking JSON Lines). A tunnel
# (`-N -R PORT:HOST:HOSTPORT`, PORT 0 for a free one) listens on 127.0.0.1 and forwards each connection to HOST:HOSTPORT
# until it is killed, and says `Allocated port N for remote forward to HOST:HOSTPORT` as ssh does. `-L
# [BIND:]PORT:HOST:HOSTPORT` is the same with the port on this side; with a command it forwards for as long as the
# command runs. When the key given with `-i` is a file, each call is appended to the file of the same name with `.log`
# added: the target, then the options and the command, one JSON line.
#
# Two variables stand for what a real ssh asks and suffers. With FAKE_SSH_ASK set, it runs $SSH_ASKPASS with that text
# as the prompt first and fails like a refused login unless the answer is FAKE_SSH_PASSWORD. With FAKE_SSH_DROP naming a
# file, a tunnel that finds the file deletes it and ends, as a dropped connection does.
import json
import os
import socket
import subprocess
import sys
import threading

WITH_VALUE = set("bcDEeFIiJLlmOopQRSWw")
args = sys.argv[1:]
options = []
forward = None
key = None
tunnel = False
i = 0
while i < len(args):
    arg = args[i]
    if arg.startswith("-") and len(arg) > 1:
        flag = arg[1]
        if flag in WITH_VALUE:
            value = args[i + 1] if len(arg) == 2 else arg[2:]
            i += 1 if len(arg) == 2 else 0
            options.append([flag, value])
            if flag in "RL":
                forward = value
            if flag == "i":
                key = value
        elif arg == "-N":
            tunnel = True
        i += 1
        continue
    break
target, command = args[i], args[i + 1:]

if key and os.path.exists(key):
    with open(key + ".log", "a") as log:
        log.write(json.dumps({"target": target, "options": options, "command": " ".join(command), "tunnel": tunnel}) + "\n")

ask = os.environ.get("FAKE_SSH_ASK")
if ask:
    answer = subprocess.run([os.environ["SSH_ASKPASS"], ask], capture_output=True, text=True).stdout.rstrip("\n")
    if answer != os.environ.get("FAKE_SSH_PASSWORD"):
        sys.stderr.write("Permission denied, please try again.\n")
        sys.exit(255)


def pump(source, sink):
    try:
        while True:
            data = source.recv(65536)
            if not data:
                break
            sink.sendall(data)
    except OSError:
        pass
    for sock in (source, sink):
        try:
            sock.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass


def listen(spec):
    parts = spec.split(":")
    bind = parts.pop(0) if len(parts) == 4 else "127.0.0.1"
    port, host, host_port = parts
    server = socket.socket()
    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    server.bind((bind, int(port)))
    server.listen()
    sys.stderr.write("Allocated port %d for remote forward to %s:%s\n" % (server.getsockname()[1], host, host_port))
    sys.stderr.flush()
    return server, host, int(host_port)


def forwarding(server, host, host_port):
    drop = os.environ.get("FAKE_SSH_DROP")
    server.settimeout(0.05)
    while True:
        if drop and os.path.exists(drop):
            os.remove(drop)
            os._exit(255)
        try:
            client, _ = server.accept()
        except socket.timeout:
            continue
        try:
            upstream = socket.create_connection((host, host_port))
        except OSError:
            client.close()
            continue
        threading.Thread(target=pump, args=(client, upstream), daemon=True).start()
        threading.Thread(target=pump, args=(upstream, client), daemon=True).start()


if tunnel:
    forwarding(*listen(forward))
if forward:
    threading.Thread(target=forwarding, args=listen(forward), daemon=True).start()
    sys.exit(subprocess.call(["sh", "-c", " ".join(command)]))

os.execvp("sh", ["sh", "-c", " ".join(command)])
