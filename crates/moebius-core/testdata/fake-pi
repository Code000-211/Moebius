#!/usr/bin/env python3
# A stand-in for `pi-bolt --mode rpc` in tests: it speaks Pi's RPC protocol (JSON Lines, split on LF only).
# A prompt containing "[commit]" commits own.txt itself and leaves the worktree clean. A prompt containing "[hang]" waits for `abort`, one containing "[nothing]" settles without changing anything, and
# a prompt for the reviewer changes nothing and answers with a verdict; any other prompt writes a file and settles.
# The text of `--append-system-prompt` containing "[write anyway]" makes the run write a file whatever the prompt says;
# containing "[break careful]", it makes a prompt containing "[careful]" change nothing.
# A prompt that does not start with "Work on issue" is a chat message: it is answered with "You said: <message>" (and
# writes the file NAME, with its directories, first if it contains "[write NAME]", and makes the branch BRANCH from the
# commit it starts at, with a commit that appends to the file FILE, for each "[propose BRANCH FILE]" in it; a
# "[propose BRANCH FILE cards=1,2]" ends the commit message with the line "Cards: 1, 2"), and Pi stays up for the next one.
# A "[propose-file BRANCH FILE BASE64]" makes the branch BRANCH the same way, with a commit that writes the file FILE,
# with its directories, with the text BASE64 encodes; a "cards=1,2" after BASE64 ends the message with "Cards: 1, 2".
# A "[lever BRANCH FILE TEXT]" makes the branch BRANCH from the commit it starts at, with a commit that sets the file FILE to
# the line TEXT, unless the branch exists already.
# A "[put NAME]" line, the text to write and a "[/put]" line make a chat write that text to the file NAME, with its directories, and commit nothing.
# A "[run COMMAND]" in a chat message runs COMMAND in a shell in the worktree and appends what it printed to the answer.
# While a "[hang]" prompt waits, a prompt with streamingBehavior is queued (kept in queued.txt). Its pid is kept in pid.txt.
# Started without `--mode rpc` (the terminal interface of a chat) it prints "tui ready" and repeats each line typed as "tui heard: LINE";
# with `--continue` it also appends what Pi's session file would hold for the line to the newest session file in
# `--session-dir` (one it makes if there is none): the person's message, an answer that thinks, says "Reading." and
# reads LINE.txt, the tool's result, and a final answer "You said: LINE".
# Every command it is sent is appended to stdin.jsonl, and `set_thinking_level` and `set_model` are answered with success.
# A `steer` is answered with a response that echoes the message. The prompt is kept in prompt.txt next to argv.json. The final answer is reported in agent_end, as Pi does.
import base64
import json
import os
import re
import subprocess
import sys

out = sys.stdout.buffer


def emit(record):
    # ensure_ascii=False writes U+2028 as raw bytes, as Pi does.
    out.write(json.dumps(record, ensure_ascii=False).encode("utf-8") + b"\n")
    out.flush()


with open(os.path.join(os.environ["PI_CODING_AGENT_DIR"], "argv.json"), "w") as f:
    json.dump(sys.argv[1:], f)
with open(os.path.join(os.environ["PI_CODING_AGENT_DIR"], "env.json"), "w") as f:
    json.dump({k: os.environ.get(k) for k in ("MOEBIUS", "MOEBIUS_CHECK_URL", "MOEBIUS_RUN_TOKEN", "MOEBIUS_URL", "MOEBIUS_TOKEN", "MOEBIUS_TOOL_OUTPUT")}, f)

with open(os.path.join(os.environ["PI_CODING_AGENT_DIR"], "pid.txt"), "w") as f:
    f.write(str(os.getpid()))

# Without `--mode rpc` it is Pi's interactive mode on a terminal: it says it is ready and repeats each line it is typed.
if "--mode" not in sys.argv:
    sessions = sys.argv[sys.argv.index("--session-dir") + 1]
    print("tui ready", flush=True)
    for line in sys.stdin:
        line = line.strip()
        if "--continue" in sys.argv:
            os.makedirs(sessions, exist_ok=True)
            files = sorted((f for f in os.listdir(sessions) if f.endswith(".jsonl")),
                           key=lambda f: os.path.getmtime(os.path.join(sessions, f)))
            path = os.path.join(sessions, files[-1] if files else "fake.jsonl")
            entries = [] if files else [{"type": "session", "version": 3, "id": "fake", "cwd": os.getcwd()}]
            call = {"type": "toolCall", "id": "tui-1", "name": "read", "arguments": {"path": line + ".txt"}}
            entries += [{"type": "message", "message": message} for message in [
                {"role": "user", "content": [{"type": "text", "text": line}]},
                {"role": "assistant", "stopReason": "toolUse", "content": [
                    {"type": "thinking", "thinking": "Let me look."}, {"type": "text", "text": "Reading."}, call]},
                {"role": "toolResult", "toolCallId": "tui-1", "toolName": "read", "isError": True, "durationMs": 3,
                 "content": [{"type": "text", "text": "no such file"}]},
                {"role": "assistant", "stopReason": "stop", "content": [{"type": "text", "text": "You said: " + line}]},
            ]]
            with open(path, "a") as f:
                for entry in entries:
                    f.write(json.dumps(entry) + "\n")
        print("tui heard: " + line, flush=True)
    sys.exit(0)

instructions = ""
if "--append-system-prompt" in sys.argv:
    instructions = sys.argv[sys.argv.index("--append-system-prompt") + 1]

hanging = False
for line in sys.stdin.buffer:
    command = json.loads(line.split(b"\n")[0])
    kind = command.get("type")
    with open(os.path.join(os.environ["PI_CODING_AGENT_DIR"], "stdin.jsonl"), "a") as f:
        f.write(json.dumps(command) + "\n")
    if kind == "prompt" and hanging and command.get("streamingBehavior"):
        with open(os.path.join(os.environ["PI_CODING_AGENT_DIR"], "queued.txt"), "w") as f:
            f.write(command["message"])
        emit({"id": command.get("id"), "type": "response", "command": "prompt", "success": True,
              "data": {"disposition": "queued"}})
    elif kind == "prompt":
        emit({"id": command.get("id"), "type": "response", "command": "prompt", "success": True,
              "data": {"disposition": "started"}})
        emit({"type": "agent_start"})
        if "[hang]" in command["message"]:
            hanging = True
            continue
        with open(os.path.join(os.environ["PI_CODING_AGENT_DIR"], "prompt.txt"), "w") as f:
            f.write(command["message"])
        if not command["message"].startswith("Work on issue"):
            answer = "You said: " + command["message"]
            written = re.search(r"\[write ([^\]]+)\]", command["message"])
            if written:
                os.makedirs(os.path.dirname(written.group(1)) or ".", exist_ok=True)
                with open(written.group(1), "w") as f:
                    f.write("written\n")
            for name, text in re.findall(r"\[put ([^\]\s]+)\]\n(.*?)\n\[/put\]", command["message"], re.DOTALL):
                os.makedirs(os.path.dirname(name) or ".", exist_ok=True)
                with open(name, "w") as f:
                    f.write(text + "\n")
            for shell in re.findall(r"\[run ([^\]]+)\]", command["message"]):
                done = subprocess.run(shell, shell=True, capture_output=True, text=True)
                answer += "\n" + done.stdout + done.stderr
            git = ["git", "-c", "user.name=pi", "-c", "user.email=pi@example.com"]
            proposals = re.findall(r"\[propose ([^\]\s]+) ([^\]\s]+)(?: cards=([0-9,]+))?\]", command["message"])
            levers = re.findall(r"\[lever ([^\]\s]+) ([^\]\s]+) ([^\]\s]+)\]", command["message"])
            start = subprocess.run(["git", "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip() if proposals or levers else ""
            for branch, name, text in levers:
                if subprocess.run(["git", "rev-parse", "--verify", "-q", "refs/heads/" + branch], capture_output=True).returncode == 0:
                    continue
                subprocess.run(git + ["checkout", "-q", "-b", branch, start], check=True)
                with open(name, "w") as f:
                    f.write(text + "\n")
                subprocess.run(git + ["add", name], check=True)
                subprocess.run(git + ["commit", "-q", "-m", "Set " + name + " to " + text], check=True)
            files = re.findall(r"\[propose-file ([^\]\s]+) ([^\]\s]+) ([^\]\s]+)(?: cards=([0-9,]+))?\]", command["message"])
            if files and not start:
                start = subprocess.run(["git", "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip()
            for branch, name, encoded, cards in files:
                subprocess.run(git + ["checkout", "-q", "-b", branch, start], check=True)
                os.makedirs(os.path.dirname(name) or ".", exist_ok=True)
                with open(name, "wb") as f:
                    f.write(base64.b64decode(encoded))
                subprocess.run(git + ["add", name], check=True)
                message = ["-m", "Change " + name, "-m", "It addresses the errors."]
                if cards:
                    message += ["-m", "Cards: " + ", ".join(cards.split(","))]
                subprocess.run(git + ["commit", "-q"] + message, check=True)
            for branch, name, cards in proposals:
                subprocess.run(git + ["checkout", "-q", "-b", branch, start], check=True)
                os.makedirs(os.path.dirname(name) or ".", exist_ok=True)
                with open(name, "a") as f:
                    f.write("Proposed.\n")
                subprocess.run(git + ["add", name], check=True)
                message = ["-m", "Change " + name, "-m", "It addresses the errors."]
                if cards:
                    message += ["-m", "Cards: " + ", ".join(cards.split(","))]
                subprocess.run(git + ["commit", "-q"] + message, check=True)
            emit({"type": "message_update",
                  "assistantMessageEvent": {"type": "text_delta", "contentIndex": 0, "delta": answer}})
            emit({"type": "agent_end", "willRetry": False, "messages": [
                {"role": "user", "content": command["message"]},
                {"role": "assistant", "content": [{"type": "text", "text": answer}]}]})
            emit({"type": "agent_settled", "aborted": False})
            continue
        reviewing = "You are the reviewer" in command["message"]
        emit({"type": "message_update",
              "assistantMessageEvent": {"type": "text_delta", "contentIndex": 0, "delta": "line one line two"}})
        nothing = "[nothing]" in command["message"] and "[write anyway]" not in instructions
        nothing = nothing or ("[careful]" in command["message"] and "[break careful]" in instructions)
        if not nothing and "[commit]" not in command["message"] and not reviewing:
            emit({"type": "tool_execution_start", "toolCallId": "t1", "toolName": "write",
                  "args": {"path": "done.txt"}})
            with open("done.txt", "w") as f:
                f.write("done\n")
            emit({"type": "tool_execution_end", "toolCallId": "t1", "toolName": "write", "isError": False})
        if "[commit]" in command["message"]:
            # Leaves the worktree clean, with its own commit.
            with open("own.txt", "w") as f:
                f.write("own\n")
            os.system("git add own.txt && git -c user.name=pi -c user.email=pi@example.com commit -q -m own")
        answer = "Looks fine.\nVERDICT: approve" if reviewing else "line one line two"
        emit({"type": "agent_end", "willRetry": False, "messages": [
            {"role": "user", "content": command["message"]},
            {"role": "assistant", "content": [{"type": "text", "text": "Working on it."},
                                              {"type": "toolCall", "id": "t1", "name": "write", "arguments": {}}]},
            {"role": "toolResult", "toolCallId": "t1", "content": [{"type": "text", "text": "ok"}]},
            {"role": "assistant", "content": [{"type": "thinking", "thinking": "hm"},
                                              {"type": "text", "text": answer}]}]})
        emit({"type": "agent_settled", "aborted": False})
    elif kind in ("set_thinking_level", "set_model"):
        emit({"id": command.get("id"), "type": "response", "command": kind, "success": True})
    elif kind == "steer":
        emit({"id": command.get("id"), "type": "response", "command": "steer", "success": True,
              "echo": command["message"]})
    elif kind == "abort":
        emit({"id": command.get("id"), "type": "response", "command": "abort", "success": True})
        if hanging:
            emit({"type": "agent_end", "messages": [], "willRetry": False})
            emit({"type": "agent_settled", "aborted": True})
