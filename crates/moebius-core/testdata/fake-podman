#!/usr/bin/env python3
# A stand-in for `podman` and `docker` in the tests of the test lane. It records the arguments of every call as one JSON
# line in the file of its own name with `.log` added. `run` runs the command in the directory the container's `-v
# HOST:/work` names, as the container would see it, with the `-e` variables; a container that has a `--name` is "there"
# while it runs (`<this file>.running.<name>`, holding the pid) and keeps its exit code after it (`.exit.<name>`), as a
# runtime that is not told `--rm` does. `inspect -f FORMAT NAME` answers `{{.State.Running}}` and `{{.State.ExitCode}}`
# from those files and fails for a container that is not there. `rm -f NAME` kills the process of a running container
# and forgets it. `ps` lists nothing. `--version` does nothing. A file `<this file>.fail` makes `run` exit 125 and make no
# container, as a runtime does that cannot start one.
import json
import os
import signal
import subprocess
import sys

args = sys.argv[1:]
here = os.path.abspath(__file__)
if args[:1] == ["--version"]:
    print("fake 1.0")
    sys.exit(0)
with open(here + ".log", "a") as log:
    log.write(json.dumps(args) + "\n")


def files(name):
    return here + ".running." + name, here + ".exit." + name


if args[:1] == ["inspect"]:
    name = args[-1]
    running, exited = files(name)
    fmt = args[args.index("-f") + 1] if "-f" in args else ""
    if os.path.exists(running):
        state = ("true", "0")
    elif os.path.exists(exited):
        state = ("false", open(exited).read().strip())
    else:
        sys.stderr.write("Error: no such container\n")
        sys.exit(1)
    print(fmt.replace("{{.State.Running}}", state[0]).replace("{{.State.ExitCode}}", state[1]) if fmt else name)
    sys.exit(0)
if args[:1] == ["rm"]:
    name = args[-1]
    running, exited = files(name)
    if os.path.exists(running):
        try:
            os.killpg(int(open(running).read().strip()), signal.SIGKILL)
        except (OSError, ValueError):
            pass
        try:
            os.kill(int(open(running).read().strip()), signal.SIGKILL)
        except (OSError, ValueError):
            pass
    for each in (running, exited):
        if os.path.exists(each):
            os.remove(each)
    sys.exit(0)
if args[:1] != ["run"]:
    sys.exit(0)
if os.path.exists(here + ".fail"):
    sys.stderr.write("Error: the image could not be pulled\n")
    sys.exit(125)

WITH_VALUE = {"--name", "--label", "--network", "--cap-drop", "--security-opt", "--user", "--pids-limit", "--tmpfs",
              "-e", "--device", "--group-add", "-v", "-w", "--timeout"}
host = None
workdir = "/work"
name = None
environment = dict(os.environ)
i = 1
while i < len(args) and args[i].startswith("-"):
    if args[i] in WITH_VALUE:
        value = args[i + 1]
        if args[i] == "-v":
            host = value.split(":")[0]
        elif args[i] == "-w":
            workdir = value
        elif args[i] == "--name":
            name = value
        elif args[i] == "-e":
            key, _, text = value.partition("=")
            environment[key] = text
        i += 2
    else:
        i += 1
command = args[i + 1:]  # after the image
text = command[-1].replace("/work", host) if host else command[-1]
cwd = workdir.replace("/work", host, 1) if host else None
if name:
    running, exited = files(name)
    with open(running, "w") as marker:
        marker.write(str(os.getpid()))
process = subprocess.Popen(["sh", "-c", text], cwd=cwd, env=environment)
code = process.wait()
if name:
    if os.path.exists(running):
        os.remove(running)
    with open(exited, "w") as marker:
        marker.write(str(code))
sys.exit(code)
