#!/usr/bin/env python3
# A stand-in for `podman` and `docker` in the tests of the test lane. It records the arguments of every call as one JSON
# line in the file of its own name with `.log` added. `run` runs the command in the directory the container's `-v
# HOST:/work` names, as the container would see it, with the `-e` variables; a container that has a `--name` is "there"
# while it runs (`<this file>.running.<name>`, holding the pid) and keeps its exit code after it (`.exit.<name>`), as a
# runtime that is not told `--rm` does. The command runs in a session of its own, which `rm -f` kills as a whole. `inspect -f FORMAT NAME` answers `{{.State.Running}}` and `{{.State.ExitCode}}`
# from those files and fails for a container that is not there. `rm -f NAME` kills the process of a running container
# and forgets it. `ps -aq --filter label=moebius-lane-job=N` lists the names of the containers made with that label, running or
# not. A `-v HOST:PATH:ro` over a path of the checkout is, while the command runs, a copy of HOST in the checkout's place,
# which is what a command that writes there sees of a read-only mount: it can write, and nothing of it is kept. `--version` does nothing. A file `<this file>.fail` makes `run` exit 125 and make no
# container, as a runtime does that cannot start one; a file `<this file>.fail-cleanup` does so for a `run --rm` only.
# A command that reads `/sys/fs/cgroup/` (the probe of the limits) is answered from the flags given instead, as a runtime
# that enforces them would show them; with a file `<this file>.nolimits` it says `max` for all, as one that ignores them does.
# The directory `denying-rm` is taken out of the `PATH` of a container's command.
import json
import os
import shutil
import signal
import subprocess
import sys

args = sys.argv[1:]
here = os.path.abspath(__file__)
if args[:1] == ["--version"]:
    print("fake 1.0")
    sys.exit(0)
with open(here + ".log", "a") as log:
    log.write(json.dumps(args) + "\n")


def files(name):
    return here + ".running." + name, here + ".exit." + name


if args[:1] == ["inspect"]:
    name = args[-1]
    running, exited = files(name)
    fmt = args[args.index("-f") + 1] if "-f" in args else ""
    if os.path.exists(running):
        state = ("true", "0")
    elif os.path.exists(exited):
        state = ("false", open(exited).read().strip())
    else:
        sys.stderr.write("Error: no such container\n")
        sys.exit(1)
    print(fmt.replace("{{.State.Running}}", state[0]).replace("{{.State.ExitCode}}", state[1]) if fmt else name)
    sys.exit(0)
if args[:1] == ["rm"]:
    name = args[-1]
    running, exited = files(name)
    if os.path.exists(running):
        try:
            os.killpg(int(open(running).read().strip()), signal.SIGKILL)
        except (OSError, ValueError):
            pass
        try:
            os.kill(int(open(running).read().strip()), signal.SIGKILL)
        except (OSError, ValueError):
            pass
    try:
        os.killpg(int(open(here + ".child." + name).read().strip()), signal.SIGKILL)
    except (OSError, ValueError):
        pass
    for each in (running, exited, here + ".job." + name, here + ".child." + name):
        if os.path.exists(each):
            os.remove(each)
    sys.exit(0)
if args[:1] == ["ps"]:
    wanted = None
    if "--filter" in args:
        wanted = args[args.index("--filter") + 1].partition("moebius-lane-job=")[2]
    prefix = os.path.basename(here) + ".job."
    for entry in sorted(os.listdir(os.path.dirname(here))):
        if entry.startswith(prefix) and open(os.path.join(os.path.dirname(here), entry)).read().strip() == wanted:
            print(entry[len(prefix):])
    sys.exit(0)
if args[:1] != ["run"]:
    sys.exit(0)
if os.path.exists(here + ".fail") or ("--rm" in args and os.path.exists(here + ".fail-cleanup")):
    sys.stderr.write("Error: the image could not be pulled\n")
    sys.exit(125)

WITH_VALUE = {"--name", "--label", "--network", "--cap-drop", "--security-opt", "--user", "--pids-limit", "--tmpfs",
              "-e", "--device", "--group-add", "-v", "-w", "--timeout", "--memory", "--memory-swap", "--oom-score-adj",
              "--ulimit", "--cpus"}
flags = {}
mounts = []  # (host path, container path)
readonly = []  # the same, for a `:ro` mount, which lies over the others
workdir = "/work"
name = None
job = None
environment = dict(os.environ)
i = 1
while i < len(args) and args[i].startswith("-"):
    if args[i] in WITH_VALUE:
        value = args[i + 1]
        flags[args[i]] = value
        if args[i] == "-v":
            host, inside, *mode = value.split(":")
            if mode == ["ro"]:
                readonly.append((host, inside))
            else:
                mounts.append((host, inside))
        elif args[i] == "--label" and value.startswith("moebius-lane-job="):
            job = value.partition("=")[2]
        elif args[i] == "-w":
            workdir = value
        elif args[i] == "--name":
            name = value
        elif args[i] == "-e":
            key, _, text = value.partition("=")
            environment[key] = text
        i += 2
    else:
        i += 1
command = args[i + 1:]  # after the image
environment["PATH"] = ":".join(p for p in environment.get("PATH", "").split(":") if not p.endswith("denying-rm"))


def outside(text):
    # The longest container path first, so that a mount over a path of another is the one that is seen.
    for host, inside in sorted(mounts, key=lambda m: -len(m[1])):
        text = text.replace(inside, host)
    return text



def lay_over():
    # A read-only mount over a path of the checkout: what the command sees there is the mount's, and what it writes there
    # is thrown away. The path is swapped for a copy of the mount's host path for as long as the command runs.
    swapped = []
    for host, inside in readonly:
        target = outside(inside)
        if not os.path.lexists(target):
            continue
        aside = target + ".moebius-aside"
        os.rename(target, aside)
        if os.path.isdir(host):
            shutil.copytree(host, target, symlinks=True)
        else:
            shutil.copy2(host, target)
        swapped.append((target, aside))
    return swapped


def lift(swapped):
    for target, aside in swapped:
        if not os.path.lexists(aside):
            continue  # the command moved the directory away, aside included
        if os.path.isdir(target) and not os.path.islink(target):
            shutil.rmtree(target, ignore_errors=True)
        elif os.path.lexists(target):
            os.remove(target)
        os.rename(aside, target)


text = outside(command[-1])
if "/sys/fs/cgroup/" in text:
    def size(text):
        units = {"k": 1 << 10, "m": 1 << 20, "g": 1 << 30, "t": 1 << 40}
        return int(text[:-1]) * units[text[-1]] if text[-1] in units else int(text)

    if os.path.exists(here + ".nolimits"):
        shown = {"memory.max": "max", "memory.swap.max": "max", "pids.max": "max", "cpu.max": "max 100000"}
    else:
        memory = size(flags["--memory"])
        shown = {
            "memory.max": str(memory),
            "memory.swap.max": str(size(flags["--memory-swap"]) - memory),
            "pids.max": flags["--pids-limit"],
            "cpu.max": "%d 100000" % int(float(flags["--cpus"]) * 100000) if "--cpus" in flags else "max 100000",
        }
    text = "; ".join("echo 'LIMIT %s %s'" % item for item in shown.items())
cwd = outside(workdir) if mounts else None
if name:
    running, exited = files(name)
    with open(running, "w") as marker:
        marker.write(str(os.getpid()))
    if job:
        with open(here + ".job." + name, "w") as marker:
            marker.write(job)
swapped = lay_over()
# In a session of its own, so that removing the container ends everything the command started, as a runtime does.
process = subprocess.Popen(["sh", "-c", text], cwd=cwd, env=environment, start_new_session=True)
if name:
    with open(here + ".child." + name, "w") as marker:
        marker.write(str(process.pid))
code = process.wait()
lift(swapped)
if name:
    if os.path.exists(running):
        os.remove(running)
    with open(exited, "w") as marker:
        marker.write(str(code))
sys.exit(code)
