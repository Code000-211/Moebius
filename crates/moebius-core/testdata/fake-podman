#!/usr/bin/env python3
# A stand-in for `podman` and `docker` in the tests of the test lane: it records the arguments of every call as one JSON
# line in the file of its own name with `.log` added, and runs the command of a `run` in the directory the container's
# `-v HOST:/work` and `-w /work/SIDE` name, as the container would see it, with the `-e` variables, so that what a job
# does can be seen. `--version` and `rm` do nothing. `FAKE_PODMAN_FAIL` in the file `<this file>.fail` makes `run` exit 125,
# as a runtime does that cannot start a container.
import json
import os
import subprocess
import sys

args = sys.argv[1:]
here = os.path.abspath(__file__)
if args[:1] == ["--version"]:
    print("fake 1.0")
    sys.exit(0)
with open(here + ".log", "a") as log:
    log.write(json.dumps(args) + "\n")
if args[:1] != ["run"]:
    sys.exit(0)
if os.path.exists(here + ".fail"):
    sys.stderr.write("Error: the image could not be pulled\n")
    sys.exit(125)

WITH_VALUE = {"--name", "--network", "--cap-drop", "--security-opt", "--user", "--pids-limit", "--tmpfs", "-e",
              "--device", "--group-add", "-v", "-w"}
host = None
workdir = "/work"
environment = dict(os.environ)
i = 1
while i < len(args) and args[i].startswith("-"):
    if args[i] in WITH_VALUE:
        value = args[i + 1]
        if args[i] == "-v":
            host = value.split(":")[0]
        elif args[i] == "-w":
            workdir = value
        elif args[i] == "-e":
            name, _, text = value.partition("=")
            environment[name] = text
        i += 2
    else:
        i += 1
command = args[i + 1:]  # after the image
text = command[-1].replace("/work", host) if host else command[-1]
cwd = workdir.replace("/work", host, 1) if host else None
sys.exit(subprocess.call(["sh", "-c", text], cwd=cwd, env=environment))
