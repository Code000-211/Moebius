{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "connect",
  "description": "The connect page bundled in the app: connecting to a server, and the window's controls.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-connect",
    "allow-connect-ssh",
    "allow-servers",
    "allow-switch-server",
    "allow-remove-server",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ]
}
