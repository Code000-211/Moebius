{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "web-app",
  "description": "The web app on the app's own address on the loopback: the window's controls and the rail of servers, and nothing else.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*/*"
    ]
  },
  "permissions": [
    "allow-connect",
    "allow-connect-ssh",
    "allow-servers",
    "allow-switch-server",
    "allow-remove-server",
    "allow-rename-server",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-is-maximized"
  ]
}
